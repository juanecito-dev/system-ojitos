includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - database/migrations/
        - routes/
    # Nivel 5 para empezar. Los errores que ya había quedan en phpstan-baseline.neon:
    # el código nuevo no puede agregar errores, y la lista se va achicando al arreglarlos.
    level: 5
